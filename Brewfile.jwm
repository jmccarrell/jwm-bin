# Personal mac (lyra) — gated by jwm_host_p (~/pdata).
# Read via `brew bundle --file`; never stowed.
#
# Anything also true of the work mac belongs in ./Brewfile, not here.
#
# Regenerate with `brew bundle dump --no-describe`, then subtract ./Brewfile.
# Never from `brew leaves`, which omits anything installed only as a dependency.
# Without --no-describe every entry gains a description comment: the file roughly
# doubles, and subtracting an entry strands its description above the next one.

tap "fluxcd/tap", trusted: true
tap "homebrew/services"
tap "mistertea/et", "https://github.com/MisterTea/homebrew-et", trusted: true
tap "siderolabs/tap", trusted: true
brew "age"
brew "aspell"
brew "openssl@3"
brew "readline"
brew "sqlite"
brew "xz"
brew "awscli"
brew "azure-cli"
brew "cilium-cli"
brew "cmake"
brew "fping"
brew "gawk"
brew "node"
brew "gemini-cli"
brew "gnutls"
brew "gopls"
brew "herdr"
brew "icu4c@76"
brew "kubectl-cnpg"
brew "libpq"
brew "make"
brew "ollama", restart_service: :changed
brew "opentofu"
brew "p7zip"
brew "pandoc"
brew "perl"
brew "pipenv"
brew "pipx"
brew "pkgconf"
brew "poetry"
brew "poppler"
brew "pure"
brew "qpdf"
brew "rclone"
brew "ruff"
brew "shellcheck"
brew "smartmontools"
brew "sops"
brew "tcl-tk"
brew "tea"
brew "the_silver_searcher"
brew "tree-sitter"
brew "tree-sitter-cli"
brew "zlib"
brew "zsh"
brew "fluxcd/tap/flux", trusted: true
brew "siderolabs/tap/talosctl", trusted: true
cask "1password-cli"
cask "bruno"
cask "claude"
cask "claude-code"
cask "emacs-app"
cask "font-fira-code-nerd-font"
cask "gcloud-cli"
cask "ghostty"
cask "orbstack"
cask "postico"
cask "rectangle"
cask "tolaria"
cask "vscodium"
cask "zed"
vscode "bierner.markdown-mermaid"
vscode "charliermarsh.ruff"
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "github.vscode-github-actions"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "skellock.just"
vscode "tamasfe.even-better-toml"
go "github.com/go-delve/delve/cmd/dlv"
go "org.mccarrell/geckoslug"
