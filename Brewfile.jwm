# Personal mac (lyra) — gated by jwm_host_p (~/pdata); never stowed.
# Anything true of both macs belongs in ./Brewfile instead.
#
# Regenerate: `brew bundle dump --no-describe`, then subtract ./Brewfile.
# Not from `brew leaves` — it omits formulae installed only as dependencies.

tap "fluxcd/tap", trusted: true
tap "homebrew/services"
tap "mistertea/et", "https://github.com/MisterTea/homebrew-et", trusted: true
tap "siderolabs/tap", trusted: true
brew "age"
brew "aspell"
brew "openssl@3"
brew "readline"
brew "sqlite"
brew "xz"
brew "awscli"
brew "azure-cli"
brew "cilium-cli"
brew "cmake"
brew "fping"
brew "node"
brew "gemini-cli"
brew "gnutls"
brew "gopls"
brew "herdr"
brew "icu4c@76"
brew "kubectl-cnpg"
brew "libpq"
brew "make"
brew "ollama", restart_service: :changed
brew "opentofu"
brew "p7zip"
brew "pandoc"
brew "pkgconf"
brew "poppler"
brew "qpdf"
brew "rclone"
brew "shellcheck"
brew "smartmontools"
brew "sops"
brew "tcl-tk"
brew "tea"
brew "the_silver_searcher"
brew "tree-sitter"
brew "tree-sitter-cli"
brew "zlib"
brew "fluxcd/tap/flux", trusted: true
brew "siderolabs/tap/talosctl", trusted: true
cask "1password-cli"
cask "bruno"
cask "claude"
cask "claude-code"
cask "emacs-app"
cask "font-fira-code-nerd-font"
cask "gcloud-cli"
cask "ghostty"
cask "orbstack"
cask "postico"
cask "rectangle"
cask "tolaria"
cask "zed"
go "github.com/go-delve/delve/cmd/dlv"
go "org.mccarrell/geckoslug"
go "golang.org/x/tools/cmd/goimports"
go "honnef.co/go/tools/cmd/staticcheck"
cargo "cargo-nextest"
uv "ansible", with: ["ansible-core", "ansible-lint"]
