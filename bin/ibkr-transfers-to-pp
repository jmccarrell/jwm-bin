#!/usr/bin/env python3
"""ibkr-transfers-to-pp -- turn IBKR Flex transfers into Portfolio Performance CSV imports.

Portfolio Performance's IBKR Flex importer reads trades, cash transactions and
corporate actions but skips the Transfer section without a word, so securities
or cash moved in from another broker never arrive. This writes them as two
files for its general CSV import (File > Import > CSV files):

    ibkr-transfers-to-pp ~/pdata/investing/incoming/ibkr/flex/*.xml --out <dir>

  <dir>/portfolio-transactions.csv   import as "Portfolio Transactions"
      stock: Delivery (Inbound|Outbound) at the market value IBKR records
      (positionAmount) on the transfer date
  <dir>/account-transactions.csv     import as "Account Transactions"
      cash: Deposit or Withdrawal of cashTransfer

Column headers are Portfolio Performance's own English names, so its CSV
dialog maps them without help; dates are yyyy-MM-dd, amounts use a dot
decimal. Account columns carry the IBKR account alias, and Portfolio
Performance matches them to its securities and cash accounts by exact name.

A transfer between two of your own IBKR accounts becomes an outbound row on
one and an inbound row on the other: it nets to zero across accounts but
counts as money out of one account and into the other.

Existing output files are left alone unless --force.
"""

import argparse
import csv
import sys
import xml.etree.ElementTree as ET
from collections import Counter
from decimal import Decimal, InvalidOperation
from pathlib import Path

PORTFOLIO_COLUMNS = [
    "Date", "Type", "Value", "Transaction Currency", "Shares", "ISIN",
    "Ticker Symbol", "Security Name", "Securities Account", "Note",
]
ACCOUNT_COLUMNS = ["Date", "Type", "Value", "Transaction Currency", "Cash Account", "Note"]
DELIVERY = {"IN": "Delivery (Inbound)", "OUT": "Delivery (Outbound)"}
CASH = {"IN": "Deposit", "OUT": "Withdrawal"}


def die(msg: str) -> None:
    print(f"ibkr-transfers-to-pp: {msg}", file=sys.stderr)
    sys.exit(1)


def iso_date(raw: str) -> str:
    # Flex writes yyyyMMdd, or yyyy-MM-dd under some query settings.
    digits = raw.replace("-", "")[:8]
    if len(digits) != 8 or not digits.isdigit():
        raise ValueError(f"unreadable date {raw!r}")
    return f"{digits[:4]}-{digits[4:6]}-{digits[6:]}"


def amount(raw: str | None, what: str) -> Decimal:
    try:
        return abs(Decimal(raw or ""))
    except InvalidOperation:
        raise ValueError(f"{what} is {raw!r}, not a number") from None


def money(raw: str | None, what: str) -> str:
    return str(amount(raw, what).quantize(Decimal("0.01")))


def shares(raw: str | None, what: str) -> str:
    # Fixed notation: a large position must not print as 1E+3.
    return format(amount(raw, what).normalize(), "f")


def convert(path: Path, portfolio_rows: list, account_rows: list, counts: Counter) -> None:
    root = ET.parse(path).getroot()
    for statement in root.iter("FlexStatement"):
        for t in statement.iter("Transfer"):
            # Only TRANSFER rows are transfers; anything else would be a subtotal.
            if t.get("levelOfDetail", "TRANSFER") != "TRANSFER":
                continue
            account = t.get("acctAlias") or t.get("accountId", "")
            direction = t.get("direction", "")
            where = f"transaction {t.get('transactionID', '?')}"
            if direction not in DELIVERY:
                raise ValueError(f"{where}: direction {direction!r}, expected IN or OUT")
            note = f"IBKR {t.get('type', '')} transfer {direction} {t.get('transactionID', '')}".strip()
            date = iso_date(t.get("date") or t.get("dateTime", ""))
            currency = t.get("currency", "")
            if t.get("assetCategory") == "CASH":
                account_rows.append({
                    "Date": date, "Type": CASH[direction],
                    "Value": money(t.get("cashTransfer"), where + " cashTransfer"),
                    "Transaction Currency": currency, "Cash Account": account, "Note": note,
                })
                counts[(account, CASH[direction])] += 1
            else:
                if not (t.get("isin") or t.get("symbol")):
                    raise ValueError(f"{where}: no ISIN or symbol to identify the security")
                portfolio_rows.append({
                    "Date": date, "Type": DELIVERY[direction],
                    "Value": money(t.get("positionAmount"), where + " positionAmount"),
                    "Transaction Currency": currency,
                    "Shares": shares(t.get("quantity"), where + " quantity"),
                    "ISIN": t.get("isin", ""), "Ticker Symbol": t.get("symbol", ""),
                    "Security Name": t.get("description", ""),
                    "Securities Account": account, "Note": note,
                })
                counts[(account, DELIVERY[direction])] += 1


def write(dest: Path, columns: list[str], rows: list[dict], force: bool) -> None:
    if dest.exists() and not force:
        print(f"{dest} exists, skipped (--force to replace)")
        return
    tmp = dest.with_suffix(".csv.part")
    with tmp.open("w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=columns)
        w.writeheader()
        w.writerows(sorted(rows, key=lambda r: (r["Date"], r["Note"])))
    tmp.replace(dest)
    print(f"wrote {dest} ({len(rows)} rows)")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("xml", nargs="+", type=Path, help="Flex Query XML files")
    ap.add_argument("--out", type=Path, default=Path.cwd(), help="directory for the CSV files")
    ap.add_argument("--force", action="store_true", help="overwrite existing CSV files")
    args = ap.parse_args()

    portfolio_rows: list[dict] = []
    account_rows: list[dict] = []
    counts: Counter = Counter()
    for path in args.xml:
        try:
            convert(path, portfolio_rows, account_rows, counts)
        except (ET.ParseError, ValueError) as e:
            die(f"{path}: {e}")

    args.out.mkdir(parents=True, exist_ok=True)
    write(args.out / "portfolio-transactions.csv", PORTFOLIO_COLUMNS, portfolio_rows, args.force)
    write(args.out / "account-transactions.csv", ACCOUNT_COLUMNS, account_rows, args.force)
    for (account, kind), n in sorted(counts.items()):
        print(f"  {account:<16} {kind:<20} {n}")


if __name__ == "__main__":
    main()
