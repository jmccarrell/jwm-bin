#!/opt/homebrew/bin/bash
# daily -- every-morning maintenance, driven by the org.mccarrell.daily
# LaunchAgent (see ../Library/LaunchAgents/org.mccarrell.daily.plist). Safe to
# run by hand as well.
#
# The same script runs on both macs. Work is organised into three sections --
# common, then jwm_host_p, then mark43_host_p -- so a chore that belongs to only
# one machine sits in that machine's block instead of being guarded inline. The
# host predicates and the gs_* repo groups both come from ~/.functions.
#
# Nothing here aborts on failure: every step runs, failures are collected, and
# one notification at the end names all of them.

set -u

log_file="${HOME}/Library/Logs/daily.log"
mkdir -p "${HOME}/Library/Logs"

# launchd gives batch jobs no terminal, so we own the log redirection here
# rather than via the plist's StandardOutPath -- that keeps the plist free of
# any absolute home-directory path, so the identical plist works on every mac.
# When run by hand (stdout is a TTY) also echo to the terminal via tee.
if [ -t 1 ]; then
    exec > >(tee -a "${log_file}") 2>&1
else
    exec >> "${log_file}" 2>&1
fi

printf '\n===== daily %s =====\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"

# Load the host predicates and the gs_* / git_sync functions, plus the real PATH
# (brew git, asdf, rustup, ...). jwm_set_path uses bash-4+ associative arrays,
# hence the Homebrew bash shebang above.
source "${HOME}/.functions"
source "${HOME}/.path"
jwm_set_path

# GS_FAILURES collects repo labels from the gs_* groups, DAILY_FAILURES the
# chores below. The gs_* groups append without resetting, so we reset here.
GS_FAILURES=()
DAILY_FAILURES=()

# Nobody reads a hint banner in a log file.
export HOMEBREW_NO_ENV_HINTS=1

# Tools are not probed with `command -v` before use. Both macs have all of
# these, so a missing one is a fault worth hearing about -- and a skip-if-absent
# guard would have quietly hidden rustup being off the launchd PATH entirely.

# ---------------------------------------------------------------- common -----
gs_common

rustup update || DAILY_FAILURES+=(rustup)

# ------------------------------------------------------------- jwm_host_p ----
if jwm_host_p; then
    gs_jwm_host

    brew update           || DAILY_FAILURES+=(brew-update)
    brew upgrade --no-ask || DAILY_FAILURES+=(brew-upgrade)
fi

# ---------------------------------------------------------- mark43_host_p ----
if mark43_host_p; then
    gs_mark43_host

    # Workbrew machine: casks are disallowed by the workspace policy
    # (/opt/workbrew/var/workbrew.env.json), and a cask upgrade is also the case
    # most likely to want a prompt -- which launchd cannot answer. So formulae
    # only. NO_AUTO_UPDATE stops upgrade re-running the update we just did.
    brew update || DAILY_FAILURES+=(brew-update)
    HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --formula \
                || DAILY_FAILURES+=(brew-upgrade)
fi

# ------------------------------------------------------- after the upgrade ---
# Chores that only a brew upgrade invalidates, so they belong after both host
# blocks above rather than in either one.
#
# Re-link the Homebrew pythons into ~/.pyenv/versions. A new brew python is the
# only thing that makes those links stale, and `brew upgrade` is the only place
# a new one arrives -- so this is the causally correct trigger. It runs from
# ~/.bash_profile via jwm_set_path today, where it costs ~0.7s of the ~1.4s
# spent starting every login shell (12 `python3 -c` version probes plus ~200
# `ln` calls) -- a once-a-day chore billed to every new terminal tab.
#
# This lands first and is deliberately inert: until jwm-dotfiles-2024#28 drops
# the startup call and adds the matching one to the `update` alias, the linking
# simply happens both here and at every shell start. That is harmless, the pass
# being idempotent, and it means no window where nothing links the pythons.
#
# Defined in ~/.path, already sourced above.
jwm_pyenv_link_homebrew_pythons || DAILY_FAILURES+=(pyenv-link)

# ---------------------------------------------------------------- report -----
failures=( "${GS_FAILURES[@]}" "${DAILY_FAILURES[@]}" )

if (( ${#failures[@]} != 0 )); then
    printf 'daily: FAILED: %s\n' "${failures[*]}"
    osascript -e "display notification \"Failed: ${failures[*]}. See ~/Library/Logs/daily.log\" with title \"daily failed\"" >/dev/null 2>&1 || true
    exit 1
fi

printf 'daily: OK\n'
exit 0
