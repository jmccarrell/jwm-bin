#!/opt/homebrew/bin/bash
# daily -- every-morning maintenance, driven by the org.mccarrell.daily
# LaunchAgent (see ../Library/LaunchAgents/org.mccarrell.daily.plist). Safe to
# run by hand as well.
#
# The same script runs on both macs. Work is organised into three sections --
# common, then jwm_host_p, then mark43_host_p -- so a chore that belongs to only
# one machine sits in that machine's block instead of being guarded inline. The
# host predicates and the gs_* repo groups both come from ~/.functions.
#
# Those host sections now hold only repo syncing. The toolchain upgrades that
# used to sit in them moved to jwm_update_tools (~/.functions), which `update`
# calls too -- the two had drifted, and daily was the one losing: it upgraded
# brew every morning and refreshed neither the completion nor the shell-init
# cache. jwm_update_tools does its own host branching, for which brew rather
# than for whose chores, so there is no longer a brew line in either section.
#
# Nothing here aborts on failure: every step runs, failures are collected, and
# one notification at the end names all of them.

set -u

log_file="${HOME}/Library/Logs/daily.log"
mkdir -p "${HOME}/Library/Logs"

# launchd gives batch jobs no terminal, so we own the log redirection here
# rather than via the plist's StandardOutPath -- that keeps the plist free of
# any absolute home-directory path, so the identical plist works on every mac.
# When run by hand (stdout is a TTY) also echo to the terminal via tee.
if [ -t 1 ]; then
    exec > >(tee -a "${log_file}") 2>&1
else
    exec >> "${log_file}" 2>&1
fi

printf '\n===== daily %s =====\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"

# Load the host predicates and the gs_* / git_sync functions, plus the real PATH
# (brew git, asdf, rustup, ...). jwm_set_path uses bash-4+ associative arrays,
# hence the Homebrew bash shebang above.
source "${HOME}/.functions"
source "${HOME}/.path"
jwm_set_path

# GS_FAILURES collects repo labels from the gs_* groups, UPDATE_FAILURES step
# labels from jwm_update_tools, DAILY_FAILURES the chores that are only ours.
# All three append without resetting, so we reset here.
GS_FAILURES=()
UPDATE_FAILURES=()
DAILY_FAILURES=()

# Nobody reads a hint banner in a log file.
export HOMEBREW_NO_ENV_HINTS=1

# Tools are not probed with `command -v` before use, here or in jwm_update_tools.
# Both macs have all of them, so a missing one is a fault worth hearing about --
# and a skip-if-absent guard would have quietly hidden rustup being off the
# launchd PATH entirely, which is the bug that set this policy.

# ---------------------------------------------------------------- common -----
gs_common

# Install both seed repos, immediately after the sync that motivates them.
#
# gs_common only pulls. Nothing linked the result, so a file added to either repo
# sat there doing nothing until someone ran `just install` by hand -- which is how
# jwm-dotfiles-2024#31 shipped .config/uv/uv.toml and it stayed unlinked, and how
# jwm-bin#11 shipped bin/update the same way. Both repos stow with --no-folding,
# one symlink per file, so a new file genuinely requires a new link.
#
# `just install` restows (-R) rather than stows, so this also removes the dangling
# symlink a file DELETED from a repo would otherwise leave behind -- see
# jwm-dotfiles-2024#34. Unconditional rather than gated on the repo having changed:
# it is 24ms, silent on a healthy tree, and exact where a HEAD comparison would
# miss an uncommitted file or a hand-broken link. On a conflict it aborts without
# touching anything and exits 1, which lands here.
( cd "$(jwm_dir)/proj/jwm-dotfiles-2024" && just install ) \
            || DAILY_FAILURES+=(dotfiles-install)

# jwm-bin restows itself, which is safe for a reason worth writing down: bash
# holds an open descriptor on the inode it is executing, and stow only replaces
# the ~/bin/daily *symlink*. Even a `git pull` that swaps bin/daily underneath
# writes a new inode and renames over it, so this process keeps reading the
# content it started with and the new version takes effect next run.
#
# One piece of history that has to stay true for this to be safe: ~/bin must be a
# real directory, not a symlink into jwm-bin/bin. It was the latter here, from
# before this repo used stow -- which made stow's target and package the same
# directory, so the -R added in #10 unstowed the package dir itself and deleted
# all eight scripts. Both macs have a real ~/bin with per-file symlinks now, which
# is the condition this line depends on.
( cd "$(jwm_dir)/proj/jwm-bin" && just install ) \
            || DAILY_FAILURES+=(jwm-bin-install)

# ------------------------------------------------------------- jwm_host_p ----
if jwm_host_p; then
    gs_jwm_host
fi

# ---------------------------------------------------------- mark43_host_p ----
if mark43_host_p; then
    gs_mark43_host
fi

# ------------------------------------------------------ toolchain upgrades ---
# brew update and a host-aware brew upgrade, then uv python upgrade, rustup
# update, and finally the bash completion and shell-init caches. The order inside
# is a dependency chain rather than a preference -- see jwm_update_tools.
#
# Here rather than in either host section because it is host-independent: it does
# its own branching, for which brew rather than for whose chores.
#
# Shared with `update` (bin/update) so the unattended and interactive paths cannot
# drift apart again. Everything in it is safe with no terminal; the steps that
# need sudo stay in bin/update, which is what keeps this line from walking into a
# password prompt launchd has no way to answer.
#
# Failures land in UPDATE_FAILURES with a per-step label, so the notification can
# still say brew-upgrade or shell-init rather than just "update".
#
# On Mark43 macs the uv step needs system-certs, because Zscaler MITMs the host
# serving python-build-standalone tarballs. That lives in ~/.config/uv/uv.toml
# (dotfiles) rather than an export, precisely because this script sources only
# ~/.functions and ~/.path -- never ~/.bash_profile.
#
# Guarded on existence, which is not paranoia about typos: ~/.functions is sourced
# at the top of this script, well before the `just install` above can stow a newly
# pulled copy. So on the first run after jwm_update_tools lands in dotfiles -- or
# any run where that repo is behind -- the function genuinely is not defined. Bare,
# the call would fail 127, append no label, and let this script report OK having
# skipped every toolchain upgrade. It takes effect next run; this says so out loud.
if declare -F jwm_update_tools > /dev/null; then
    jwm_update_tools
else
    printf 'daily: jwm_update_tools not defined in ~/.functions; skipping upgrades\n' >&2
    DAILY_FAILURES+=(update-tools-missing)
fi

# ---------------------------------------------------------------- report -----
failures=( "${GS_FAILURES[@]}" "${UPDATE_FAILURES[@]}" "${DAILY_FAILURES[@]}" )

if (( ${#failures[@]} != 0 )); then
    printf 'daily: FAILED: %s\n' "${failures[*]}"
    osascript -e "display notification \"Failed: ${failures[*]}. See ~/Library/Logs/daily.log\" with title \"daily failed\"" >/dev/null 2>&1 || true
    exit 1
fi

printf 'daily: OK\n'
exit 0
