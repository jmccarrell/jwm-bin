#!/opt/homebrew/bin/bash
# daily -- every-morning maintenance, driven by the org.mccarrell.daily
# LaunchAgent (see ../Library/LaunchAgents/org.mccarrell.daily.plist). Safe to
# run by hand as well.
#
# Nothing here aborts on failure: every step runs, failures are collected, and
# one notification at the end names all of them.

set -u

log_file="${HOME}/Library/Logs/daily.log"
mkdir -p "${HOME}/Library/Logs"

# launchd gives batch jobs no terminal, so we own the log redirection here
# rather than via the plist's StandardOutPath -- that keeps the plist free of
# any absolute home-directory path, so the identical plist works on every mac.
# When run by hand (stdout is a TTY) also echo to the terminal via tee.
if [ -t 1 ]; then
    exec > >(tee -a "${log_file}") 2>&1
else
    exec >> "${log_file}" 2>&1
fi

printf '\n===== daily %s =====\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"

# Load the host predicates and the gs_* / git_sync functions, plus the real PATH
# (brew git, mise shims, rustup, ...). jwm_set_path uses bash-4+ associative
# arrays, hence the Homebrew bash shebang above.
source "${HOME}/.functions"
source "${HOME}/.path"
jwm_set_path

# GS_FAILURES collects repo labels from the gs_* groups, UPDATE_FAILURES step
# labels from jwm_update_tools, DAILY_FAILURES the chores that are only ours.
# All three append without resetting, so we reset here.
GS_FAILURES=()
UPDATE_FAILURES=()
DAILY_FAILURES=()

# Nobody reads a hint banner in a log file.
export HOMEBREW_NO_ENV_HINTS=1

# Tools are not probed with `command -v` before use, here or in jwm_update_tools.
# Both macs have all of them, so a missing one is a fault worth hearing about --
gs_common
( cd "$(jwm_dir)/proj/jwm-dotfiles-2024" && just install ) \
            || DAILY_FAILURES+=(dotfiles-install)
( cd "$(jwm_dir)/proj/jwm-bin" && just install ) \
            || DAILY_FAILURES+=(jwm-bin-install)

if jwm_host_p; then
    gs_jwm_host
fi

if mark43_host_p; then
    gs_mark43_host
fi

if declare -F jwm_update_tools > /dev/null; then
    jwm_update_tools
else
    printf 'daily: jwm_update_tools not defined in ~/.functions; skipping upgrades\n' >&2
    DAILY_FAILURES+=(update-tools-missing)
fi

# report
failures=( "${GS_FAILURES[@]}" "${UPDATE_FAILURES[@]}" "${DAILY_FAILURES[@]}" )

if (( ${#failures[@]} != 0 )); then
    printf 'daily: FAILED: %s\n' "${failures[*]}"
    osascript -e "display notification \"Failed: ${failures[*]}. See ~/Library/Logs/daily.log\" with title \"daily failed\"" >/dev/null 2>&1 || true
    exit 1
fi

printf 'daily: OK\n'
exit 0
